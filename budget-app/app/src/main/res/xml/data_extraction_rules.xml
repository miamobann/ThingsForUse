<?xml version="1.0" encoding="utf-8"?>
<!-- 안드로이드 12 이상: 구글 드라이브(구글 계정) 백업과 기기 간 이전에 DB와 설정을 포함한다 -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
